{
  "name": "wurth-kpi",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Würth KPI- en QBR-tool van Neele-Vat",
  "scripts": {
    "dev": "vite build -c vite.present.config.ts && vite",
    "build": "vite build -c vite.present.config.ts && vite build",
